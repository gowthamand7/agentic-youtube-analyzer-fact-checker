# Anthropic Claude API Key (Required)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Tavily Search API Key (Required for live fact-checking)
TAVILY_API_KEY=

# YouTube Data API v3 Key (Recommended for comments and channel metadata)
YOUTUBE_API_KEY=

# Supadata (optional transcript fallback, used only when the YouTube scraper is blocked).
# Comma-separated keys; an exhausted key is skipped for an hour and the next is tried.
SUPADATA_API_KEYS=

# Reddit API Credentials (Optional - system falls back to keyless search)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AgenticYouTubeAnalyzer/1.0

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=youtube_agent
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=secret
